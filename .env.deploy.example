# Copy this file to .env.deploy on the server and fill real values there.

MIAODA_APP_ID=app_17a7d7fdmvg

# PostgreSQL used by both the bill system and Cherry Studio MCP.
SUDA_DATABASE_URL=
MALL_RECONCILIATION_DATABASE_URL=

# OpenAI-compatible vision model.
VISION_LLM_BASE_URL=https://express-ent-admin.cherryin.ai/v1
VISION_LLM_API_KEY=
VISION_LLM_MODEL=minimax/minimax-m3
VISION_LLM_TIMEOUT_MS=120000
VISION_LLM_MAX_RETRIES=1
VISION_LLM_RETRY_DELAY_MS=1500
VISION_LLM_PRIMARY_MAX_TOKENS=3000
VISION_LLM_SALES_MAX_TOKENS=2200
VISION_LLM_FEE_MAX_TOKENS=3000

# Optional but recommended. Cherry Studio must send Authorization: Bearer <token>.
CHERRY_MCP_ACCESS_TOKEN=
